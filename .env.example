# Copy to .env and fill in. .env is gitignored; the pre-commit hook blocks it too.
# Variables are listed with the milestone that first reads them.

# ---- Gemini Prediction Markets ----
# M1: public market data (real prices, no auth, read-only)
GEMINI_MARKET_DATA_URL=https://api.gemini.com
# M3: orders go to the SANDBOX only. Sandbox key must be account-scoped,
# with time-based nonce and Trading enabled.
GEMINI_TRADING_ENV=sandbox
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Hard cap on a single order's notional, enforced in code independently of policy.
GEMINI_MAX_ORDER_NOTIONAL_USD=1.00

# ---- LLM (M3) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=

# ---- Solana devnet (M2) ----
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK_CAIP2=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
VAULT_PROGRAM_ID=8en8vCL4DR8e3Y739FSgKtLzFvTwiMvD8GVgnKGTBV2x
OWNER_KEYPAIR_PATH=.keys/owner.json
GUARDIAN_KEYPAIR_PATH=.keys/guardian.json

# ---- x402 paid news (M4) ----
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NEWS_URL=http://127.0.0.1:4021
X402_NEWS_PORT=4021
X402_NEWS_PRICE=$0.001
# Wallet that receives news payments (public address of .keys/news-seller.json)
X402_PAY_TO=
# Devnet wallet we control that plays the attacker in planted posts
# (public address of .keys/attacker.json). Drains to it are real and reversible.
DEMO_ATTACKER_ADDRESS=
# recorded | live   (live needs X_BEARER_TOKEN and paid X API credits)
FEED_MODE=recorded
# Random secret for POST /admin/inject. Leave empty to disable the admin routes.
NEWS_ADMIN_TOKEN=
X_BEARER_TOKEN=

# ---- QuickNode Streams (M5) ----
QUICKNODE_STREAM_SECURITY_TOKEN=

# ---- ElevenLabs (M6) ----
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
